GasBuilder.builder(<resource:mekanism:liquid/liquid>).tint(0xE0702A).build("ocular_extract");
GasBuilder.builder(<resource:mekanism:liquid/liquid>).tint(0xF09040).build("ocular_solution");
GasBuilder.builder(<resource:mekanism:liquid/liquid>).tint(0x9E1B32).build("crimson_oxide");
GasBuilder.builder(<resource:mekanism:liquid/liquid>).tint(0xC02040).build("crimson_acid");
GasBuilder.builder(<resource:mekanism:liquid/liquid>).tint(0xB090D0).build("neural_extract");
GasBuilder.builder(<resource:mekanism:liquid/liquid>).tint(0x8A6FB0).build("mycelial_solution");
