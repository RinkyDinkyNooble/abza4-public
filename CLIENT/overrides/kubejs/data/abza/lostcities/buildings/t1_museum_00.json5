// t1_museum: one chunk of 3 by 3 chunks, 3 storeys and 2 cellars
{
  "refpalette": "abza:t1_museum",
  "filler": "ӣ",
  "allowDoors": false,
  "allowFillers": false,
  "overrideFloors": true,
  "minfloors": 3,
  "maxfloors": 3,
  "mincellars": 2,
  "maxcellars": 2,
  "parts": [
    {
      "part": "abza:t1_museum_00_c2",
      "cellar": true,
      "range": "-2,-2"
    },
    {
      "part": "abza:t1_museum_00_c1",
      "cellar": true,
      "range": "-1,-1"
    },
    {
      "part": "abza:t1_museum_00_ground",
      "top": false,
      "ground": true
    },
    {
      "part": "abza:t1_museum_00_l1",
      "top": false,
      "floor": 1
    },
    {
      "part": "abza:t1_museum_00_l2",
      "top": false,
      "floor": 2
    },
    {
      "part": "abza:t1_museum_00_top",
      "top": true
    }
  ]
}
